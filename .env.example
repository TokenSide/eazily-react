# -----------------------------------------------------------------------------
# Sample mode (default). No credentials, no network: every screen runs on local
# fixtures. `npm run dev` and `npm run build` need nothing here.
# -----------------------------------------------------------------------------

# Show the partner demo entry point. Development only.
VITE_PARTNER_DEMO=false

# Local OTP bypass (4-digit code 0000). Development builds ONLY. scripts/build-policy.mjs
# fails any application build that ships the dev OTP runtime.
VITE_ENABLE_LOCAL_OTP=false

# -----------------------------------------------------------------------------
# Connected mode. Only read by builds that declare a non-production target, e.g.
#   EAZILY_TARGET_ENV=staging npm run build:staging
# scripts/build-policy.mjs refuses a production or undeclared build that bundles
# these values, so a production bundle can never point at a hosted backend.
#
# Copy this file to `.env.staging.local` and fill in the values from
# Supabase -> Project Settings -> API. Do not commit that file.
# -----------------------------------------------------------------------------


# Project URL, e.g. https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=

# New-style publishable key (sb_publishable_...). This is a PUBLIC key and is
# only safe because Row Level Security is enabled on every application table.
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon JWT. Use only if you have not migrated to publishable keys.
# VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# NEVER add any of the following to this file or to .env.staging.local:
#   SUPABASE_SERVICE_ROLE_KEY, VITE_*SECRET*, VITE_*PASSWORD*, Cashfree secrets
# They are server-only. Putting a service-role key in any VITE_ variable exposes
# it to every browser, and the build policy fails the build if it detects one in
# the output.
# -----------------------------------------------------------------------------